# Copy to .env and adjust. .env is git-ignored.

# LM Studio's OpenAI-compatible endpoint
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio

# Leave MODEL empty to auto-detect the first model loaded in LM Studio,
# or set a specific model id to compare models head-to-head.
MODEL=

TEMPERATURE=0.8

# The companion's name. Set it to whatever you like.
BOT_NAME=Companion
HISTORY_TURNS=20

# Phone push on reach-out (optional; self-hosted Bark). Leave empty/commented to disable.
# NOTIFY_URL = your Bark device endpoint. NOTIFY_UI_URL = the web-UI address the notification
# opens when tapped (e.g. your reverse proxy or VPN hostname).
# NOTIFY_URL=http://<host>:8090/<your_device_key>
# NOTIFY_UI_URL=https://<your-host>
# NOTIFY_ICON = optional custom notification image; the phone fetches this URL, so it must be
# reachable from your phone. Drop an image in web/static/ and point here at your web-UI address:
# NOTIFY_ICON=https://<your-host>/static/icon.png
